_copilot_token_from_keychain() {
  local account_host="$1" account_login="$2" account_key
  [[ -n "$account_login" ]] || return 1

  if [[ "$OSTYPE" == darwin* ]] && command -v security >/dev/null 2>&1; then
    account_key="${account_host}:${account_login}"
    security find-generic-password -s "copilot-cli" -a "$account_key" -w 2>/dev/null
  elif command -v secret-tool >/dev/null 2>&1; then
    account_key="${account_host}:${account_login}"
    secret-tool lookup service "copilot-cli" account "$account_key" 2>/dev/null ||
      secret-tool lookup service "copilot-cli" 2>/dev/null
  else
    return 1
  fi
}

_copilot_resolve_token() {
  local account_info account_host="https://github.com" account_login="" token=""

  token=$(_copilot_token_from_env) || true
  [[ -n "$token" ]] && { printf '%s' "$token"; return 0; }

  token=$(_copilot_cache_read) || true
  [[ -n "$token" ]] && { printf '%s' "$token"; return 0; }

  account_info=$(_copilot_active_account) || true
  if [[ -n "$account_info" ]]; then
    IFS=$'\t' read -r account_host account_login <<<"$account_info"
    [[ -n "$account_host" ]] || account_host="https://github.com"
  fi

  token=$(_copilot_token_from_keychain "$account_host" "$account_login") || true
  if [[ -n "$token" ]]; then
    _copilot_cache_write "$token"
    printf '%s' "$token"
    return 0
  fi

  token=$(_copilot_token_from_plaintext_config) || true
  if [[ -n "$token" ]]; then
    _copilot_cache_write "$token"
    printf '%s' "$token"
    return 0
  fi

  return 1
}

_copilot_auth_source_available() {
  [[ -n "${COPILOT_GITHUB_TOKEN:-}" ]] && return 0
  _copilot_cache_read >/dev/null 2>&1 && return 0
  _copilot_active_account >/dev/null 2>&1 && return 0
  command -v copilot >/dev/null 2>&1
}

# Expand a Copilot reset value for normalize_epoch. Date-only values need a
# time; fields named *_utc must be anchored to UTC or the reset renders
# shifted by the local UTC offset.
copilot_expand_reset() {
  local tag="$1" date="$2"
  case "$date" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
    if [[ "$tag" == "utc" ]]; then
      printf '%sT00:00:00Z' "$date"
    else
      printf '%sT00:00:00' "$date"
    fi
    ;;
  *)
    printf '%s' "$date"
    ;;
  esac
}

fetch_copilot() {
  local token=""

  token=$(_copilot_resolve_token) || true

  if [[ -z "$token" ]]; then
    draw_error "not logged in — set COPILOT_GITHUB_TOKEN or run: copilot login"
    return
  fi

  local resp _status
  http_json "https://api.github.com/copilot_internal/user" "" \
    "Authorization: token $token" \
    "Accept: application/json" \
    "Editor-Version: vscode/1.96.2" \
    "Editor-Plugin-Version: copilot-chat/0.26.7" \
    "User-Agent: GitHubCopilotChat/0.26.7" \
    "X-Github-Api-Version: 2025-04-01"
  resp="$HTTP_BODY"
  _status="$HTTP_STATUS"

  if [[ "$_status" != 2* ]] || [[ -z "$resp" ]]; then
    [[ "$_status" == "401" || "$_status" == "403" ]] && _copilot_cache_clear
    draw_http_error "$_status" "session expired — run: copilot login"
    return
  fi

  # ── Step 1: try quota_snapshots ───────────────────────────────────────────
  # token_based_billing plans expose AI Credits through the premium snapshot.
  # Legacy annual plans use the same shape for premium requests.
  local plan sku token_based
  local premium_pct premium_ent premium_used chat_pct completions_pct
  local qs_p_pct qs_p_ent qs_p_rem qs_p_used
  local qs_c_pct qs_c_ent qs_c_rem qs_comp_pct qs_comp_ent qs_comp_rem
  local mq_completions lq_completions mq_chat lq_chat
  local reset_tag reset_date copilot_values
  copilot_values=$(
    printf '%s' "$resp" | jq -jr '
        def populated_object: type == "object" and length > 0;
        def quota_value($snapshot; $value):
          if $snapshot == null or $snapshot.unlimited == true then ""
          else $value // "" end;
        def clean_credits: (. * 100 | round / 100);
        . as $root |
        ($root.quota_snapshots // {}) as $snapshots |
        (if ($snapshots.premium_interactions | populated_object) then $snapshots.premium_interactions
         elif ($snapshots.premium_models | populated_object) then $snapshots.premium_models
         else {} end) as $premium |
        (if ($root.token_based_billing | type) == "boolean" then $root.token_based_billing
         else ($premium.token_based_billing // false) end) as $token_based |
        (if $premium.unlimited == true or ($premium.entitlement | type) != "number" then ""
         elif (($premium.overage_count // 0) | type) == "number" and ($premium.overage_count // 0) > 0
           then (([$premium.entitlement - ([$premium.quota_remaining // 0, 0] | max), 0] | max)
             + $premium.overage_count | clean_credits)
         elif (($premium.quota_remaining // $premium.remaining) | type) == "number"
           then ([$premium.entitlement - ($premium.quota_remaining // $premium.remaining), 0] | max | clean_credits)
         else "" end) as $premium_used |
        ([
          ["utc", $root.quota_reset_date_utc], ["local", $root.quota_reset_date],
          ["utc", $premium.quota_reset_at], ["utc", $premium.reset_date],
          ["local", $root.limited_user_reset_date]
        ] | map(select(.[1] != null and .[1] != "")) | .[0] // ["", ""]) as $reset |
        [
          ($root.copilot_plan // ""),
          ($root.access_type_sku // ""),
          $token_based,
          quota_value($premium; $premium.percent_remaining),
          quota_value($premium; $premium.entitlement),
          quota_value($premium; ($premium.quota_remaining // $premium.remaining)),
          $premium_used,
          quota_value($snapshots.chat; $snapshots.chat.percent_remaining),
          quota_value($snapshots.chat; $snapshots.chat.entitlement),
          quota_value($snapshots.chat; ($snapshots.chat.quota_remaining // $snapshots.chat.remaining)),
          quota_value($snapshots.completions; $snapshots.completions.percent_remaining),
          quota_value($snapshots.completions; $snapshots.completions.entitlement),
          quota_value($snapshots.completions; ($snapshots.completions.quota_remaining // $snapshots.completions.remaining)),
          ($root.monthly_quotas.completions // ""),
          ($root.limited_user_quotas.completions // ""),
          ($root.monthly_quotas.chat // ""),
          ($root.limited_user_quotas.chat // ""),
          $reset[0],
          $reset[1]
        ] | map(if . == null then "" else tostring end) | join("\u001f")
      ' 2>/dev/null
  )
  IFS=$'\x1f' read -r \
    plan sku token_based \
    qs_p_pct qs_p_ent qs_p_rem qs_p_used \
    qs_c_pct qs_c_ent qs_c_rem \
    qs_comp_pct qs_comp_ent qs_comp_rem \
    mq_completions lq_completions mq_chat lq_chat \
    reset_tag reset_date <<<"$copilot_values"

  # Use percent_remaining if present; otherwise derive from entitlement + remaining
  if [[ -n "$qs_p_pct" && "$qs_p_pct" != "null" ]]; then
    premium_pct="$qs_p_pct"
  elif [[ -n "$qs_p_ent" && "$qs_p_ent" != "null" && -n "$qs_p_rem" && "$qs_p_rem" != "null" ]]; then
    premium_pct=$(percent_remaining_of "$qs_p_ent" "$qs_p_rem")
  fi
  premium_ent="$qs_p_ent"
  premium_used="$qs_p_used"

  if [[ -n "$qs_c_pct" && "$qs_c_pct" != "null" ]]; then
    chat_pct="$qs_c_pct"
  elif [[ -n "$qs_c_ent" && "$qs_c_ent" != "null" && -n "$qs_c_rem" && "$qs_c_rem" != "null" ]]; then
    chat_pct=$(percent_remaining_of "$qs_c_ent" "$qs_c_rem")
  fi

  if [[ -n "$qs_comp_pct" && "$qs_comp_pct" != "null" ]]; then
    completions_pct="$qs_comp_pct"
  elif [[ -n "$qs_comp_ent" && "$qs_comp_ent" != "null" && -n "$qs_comp_rem" && "$qs_comp_rem" != "null" ]]; then
    completions_pct=$(percent_remaining_of "$qs_comp_ent" "$qs_comp_rem")
  fi

  # ── Step 2: fallback — derive from monthly_quotas + limited_user_quotas ───
  # monthly_quotas = entitlement (limit); limited_user_quotas = remaining
  if [[ -z "$completions_pct" ]] && [[ -n "$mq_completions" && "$mq_completions" != "null" ]] && [[ -n "$lq_completions" && "$lq_completions" != "null" ]]; then
    completions_pct=$(percent_remaining_of "$mq_completions" "$lq_completions")
  fi

  if [[ -z "$chat_pct" ]] && [[ -n "$mq_chat" && "$mq_chat" != "null" ]] && [[ -n "$lq_chat" && "$lq_chat" != "null" ]]; then
    chat_pct=$(percent_remaining_of "$mq_chat" "$lq_chat")
  fi

  local reset_epoch
  reset_date=$(copilot_expand_reset "$reset_tag" "$reset_date")
  reset_epoch=$(normalize_epoch "$reset_date")

  # ── Render ────────────────────────────────────────────────────────────────
  if [[ -n "$premium_pct" || -n "$chat_pct" || -n "$completions_pct" ]]; then
    local premium_label="Premium" premium_used_pct chat_used completions_used rendered=0
    [[ "$token_based" == "true" ]] && premium_label="AI Credits"

    if [[ -n "$premium_pct" ]]; then
      premium_used_pct=$(calculate_used_percent_from_remaining "$premium_pct")
      draw_bar "$premium_label" "$premium_used_pct"
      if [[ "$token_based" == "true" && -n "$premium_used" && -n "$premium_ent" ]]; then
        printf "  %-*s ${DIM}%s / %s credits${RESET}\n" "$LABEL_WIDTH" "" "$premium_used" "$premium_ent"
      fi
      rendered=1
    fi
    if [[ -n "$chat_pct" ]]; then
      chat_used=$(calculate_used_percent_from_remaining "$chat_pct")
      ((rendered == 1)) && printf "\n"
      draw_bar "Chat" "$chat_used"
      rendered=1
    fi
    if [[ -n "$completions_pct" ]]; then
      completions_used=$(calculate_used_percent_from_remaining "$completions_pct")
      ((rendered == 1)) && printf "\n"
      draw_bar "Completions" "$completions_used"
    fi
    draw_reset "$reset_epoch"
    [[ -n "$plan" ]] && printf "  %-*s ${DIM}%s${RESET}\n" "$LABEL_WIDTH" "" "$plan"
  else
    # No quota data (e.g. Copilot Business seat — limits managed at org level)
    local plan_label="${sku:-${plan:-unknown}}"
    printf "  %-*s ${DIM}%s${RESET}\n" "$LABEL_WIDTH" "Plan" "${plan_label//_/ }"
  fi
}

# ── opencode go ─────────────────────────────────────────
_opencode_go_resolve_key() {
  local key="${OPENCODE_GO_API_KEY:-${OPENCODE_API_KEY:-}}" auth_file

  if [[ -n "$key" ]]; then
    printf '%s' "$key"
    return 0
  fi

  auth_file="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json"
  [[ -f "$auth_file" ]] || return 1

  # `opencode auth login` stores the API key under the "opencode" provider
  # id; prefer a dedicated "opencode-go" entry, then the generic one. Skip
  # non-object and empty-key entries so a broken dedicated entry cannot
  # shadow a valid generic one.
  key=$(jq -r '
    [(.["opencode-go"] // empty), (.["opencode"] // empty)] |
    map(select(type == "object" and .type == "api"
               and (.key | type) == "string" and .key != "")) |
    first | .key // empty
  ' "$auth_file" 2>/dev/null) || true
  [[ -n "$key" ]] || return 1

  printf '%s' "$key"
}

_opencode_go_auth_source_available() {
  _opencode_go_resolve_key >/dev/null 2>&1
}

_opencode_go_draw_window() {
  local label="$1" pct="$2" reset_at="$3" status="$4" mode="${5:-datetime}" note="" reset_epoch

  if [[ "$status" == "rate-limited" ]]; then
    note="rate limited"
  fi

  draw_bar "$label" "$pct" "$note"

  reset_epoch=$(normalize_epoch "$reset_at")
  if [[ -n "$reset_epoch" ]]; then
    draw_reset "$reset_epoch" "$mode"
  fi
}

fetch_opencode_go() {
  local key="" resp status

  key=$(_opencode_go_resolve_key) || true
  if [[ -z "$key" ]]; then
    draw_error "not logged in — set OPENCODE_GO_API_KEY or OPENCODE_API_KEY, or run: opencode auth login"
    return
  fi

  http_json "https://opencode.ai/zen/go/v1/usage" "" \
    "Authorization: Bearer $key" \
    "Accept: application/json"
  resp="$HTTP_BODY"
  status="$HTTP_STATUS"

  if [[ "$status" != 2* ]]; then
    case "$status" in
    401)
      if [[ -n "${OPENCODE_GO_API_KEY:-}" || -n "${OPENCODE_API_KEY:-}" ]]; then
        draw_error "OpenCode Go API key is invalid — check OPENCODE_GO_API_KEY or OPENCODE_API_KEY"
      else
        draw_error "OpenCode Go API key is invalid — run: opencode auth login"
      fi
      ;;
    403) draw_error "this key has no OpenCode Go subscription — see opencode.ai/zen/go" ;;
    *) draw_http_error "$status" "OpenCode Go authentication failed" ;;
    esac
    return
  fi

  if [[ -z "$resp" ]]; then
    draw_error "OpenCode Go usage data is unavailable"
    return
  fi

  local usage_values
  local rolling_pct rolling_reset_at rolling_status
  local weekly_pct weekly_reset_at weekly_status
  local monthly_pct monthly_reset_at monthly_status
  usage_values=$(printf '%s' "$resp" | jq -jr '
    (.usage // {}) as $usage |
    [
      $usage.rolling.percent, $usage.rolling.resetsAt, $usage.rolling.status,
      $usage.weekly.percent, $usage.weekly.resetsAt, $usage.weekly.status,
      $usage.monthly.percent, $usage.monthly.resetsAt, $usage.monthly.status
    ] |
    map(if . == null then "" else tostring end) |
    join("\u001f")
  ' 2>/dev/null) || true
  IFS=$'\x1f' read -r \
    rolling_pct rolling_reset_at rolling_status \
    weekly_pct weekly_reset_at weekly_status \
    monthly_pct monthly_reset_at monthly_status <<<"$usage_values"

  local rendered=0

  if [[ "$rolling_pct" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    _opencode_go_draw_window "5h" "$rolling_pct" "$rolling_reset_at" "$rolling_status" "time"
    rendered=1
  fi

  if [[ "$weekly_pct" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    ((rendered == 1)) && printf "\n"
    _opencode_go_draw_window "Weekly" "$weekly_pct" "$weekly_reset_at" "$weekly_status"
    rendered=1
  fi

  if [[ "$monthly_pct" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    ((rendered == 1)) && printf "\n"
    _opencode_go_draw_window "Monthly" "$monthly_pct" "$monthly_reset_at" "$monthly_status"
    rendered=1
  fi

  ((rendered == 1)) || draw_error "OpenCode Go usage data is unavailable"
}

# ── main ───────────────────────────────────────────────

usage() {
  cat <<'EOF'
Usage: aiusage [provider ...]
       aiusage --version
       aiusage update

Providers:
  claude       Show Claude usage
  codex        Show Codex usage
  codex-spark  Show Codex Spark usage (alias: spark)
  cursor       Show Cursor usage (auto-detects from browser or CURSOR_COOKIE)
  gemini       Show Gemini CLI usage
  jetbrains    Show JetBrains AI usage
  copilot      Show GitHub Copilot usage (uses copilot login or COPILOT_GITHUB_TOKEN)
  opencode-go  Show OpenCode Go usage (uses opencode login or an OpenCode API key)

Pass one or more providers to print only those sections.
Omit provider, or pass 'all', to print all detected providers.
EOF
}

run_from_args() {
  local requested=() arg
  local run_all=0

  if (($# == 0)); then
    check_required_dependencies
    run_all_parallel
    return
  fi

  if [[ "$1" == "update" ]]; then
    if (($# == 1)); then
      update_aiusage
      return
    fi
    if (($# == 2)) && [[ "$2" == "-h" || "$2" == "--help" || "$2" == "help" ]]; then
      usage
      return
    fi
    printf "aiusage update: no additional arguments are supported\n" >&2
    return 1
  fi

  for arg in "$@"; do
    case "$arg" in
    -h | --help | help)
      usage
      return
      ;;
    --version)
      printf "aiusage %s\n" "$VERSION"
      return
      ;;
    update)
      printf "aiusage update must be used as a standalone command\n" >&2
      return 1
      ;;
    all)
      run_all=1
      ;;
    *)
      arg=$(provider_canonical_slug "$arg")
      if ! provider_is_known "$arg"; then
        printf "Unknown provider: %s\n\n" "$arg" >&2
        usage >&2
        return 1
      fi

      if (( ${#requested[@]} == 0 )) || ! provider_list_contains "$arg" "${requested[@]}"; then
        requested+=("$arg")
      fi
      ;;
    esac
  done

  if ((run_all)); then
    check_required_dependencies
    run_all_parallel
    return
  fi

  # Codex and Spark share one upstream response and one display section.
  # Collapse an explicit pair into one internal provider, preserving the
  # position of whichever selector appeared first.
  if provider_list_contains "codex" "${requested[@]}" &&
    provider_list_contains "codex-spark" "${requested[@]}"; then
    local combined=() combined_added=0 provider
    for provider in "${requested[@]}"; do
      case "$provider" in
      codex | codex-spark)
        if ((combined_added == 0)); then
          combined+=("codex-all")
          combined_added=1
        fi
        ;;
      *) combined+=("$provider") ;;
      esac
    done
    requested=("${combined[@]}")
  fi

  check_required_dependencies
  NAMED_PROVIDERS_RC=0
  run_named_providers "${requested[@]}"
  return "$NAMED_PROVIDERS_RC"
}

# Only run the CLI entry point when executed directly, not when sourced by tests.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  # Print the trailing newline via an EXIT trap so set -e exits (error
  # paths) keep it. Do NOT wrap run_from_args in `cmd || rc=$?`: putting a
  # function call in an || list disables errexit inside everything it
  # calls, including the background provider workers.
  trap 'printf "\n"' EXIT
  run_from_args "$@"
  trap - EXIT
  printf "\n"
fi
