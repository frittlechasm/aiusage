#!/usr/bin/env bash
set -euo pipefail

# ── config ──────────────────────────────────────────────
VERSION="0.2.0"
UPDATE_RELEASE_API_URL="https://api.github.com/repos/frittlechasm/aiusage/releases/latest"
UPDATE_RAW_BASE_URL="https://raw.githubusercontent.com/frittlechasm/aiusage"
BAR_WIDTH=20
LABEL_WIDTH=11
FILL="█"
EMPTY="░"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
DIM="\033[2m"
BOLD="\033[1m"
RESET="\033[0m"

# Disable ANSI escapes for non-interactive output and NO_COLOR terminals.
if [[ ! -t 1 || -n "${NO_COLOR:-}" || "${TERM:-}" == "dumb" ]]; then
  GREEN=""
  YELLOW=""
  RED=""
  DIM=""
  BOLD=""
  RESET=""
fi

# ── helpers ─────────────────────────────────────────────

# Return value when it is a plain integer or decimal number, else fallback.
# Every API-derived value must pass through this before it reaches bash
# arithmetic, an interpolated awk program, or draw_* helpers: bash evaluates
# variable contents as expressions and awk splices them as program text.
# Remove leading zeros so bash never reads a value as octal ("value too
# great for base"). Pure text handling: arbitrarily large values pass
# through unchanged.
strip_leading_zeros() {
  local value="$1"
  while [[ "$value" == 0[0-9]* || "$value" == -0[0-9]* ]]; do
    value="${value/0}"
  done
  printf '%s' "$value"
}

numeric_or() {
  local value="${1:-}" fallback="${2-0}"
  [[ "$value" =~ ^-?[0-9]+([.][0-9]+)?$ ]] || value="$fallback"
  strip_leading_zeros "$value"
}

# Percent remaining given entitlement and remainder; empty on bad input.
percent_remaining_of() {
  local entitlement remainder
  entitlement=$(numeric_or "${1:-}" 0)
  remainder=$(numeric_or "${2:-}" 0)
  awk "BEGIN{e=$entitlement; if(e>0) printf \"%.1f\", ($remainder/e)*100}" 2>/dev/null || true
}

required_dependency_install_hint() {
  if [[ "${OSTYPE:-}" == darwin* ]] || [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]]; then
    cat <<'EOF'
Install missing dependencies with:
  brew install curl jq
EOF
    return 0
  fi

  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-}" in
    debian | ubuntu | linuxmint | pop)
      cat <<'EOF'
Install missing dependencies with:
  sudo apt-get update && sudo apt-get install -y curl jq
EOF
      return 0
      ;;
    fedora)
      cat <<'EOF'
Install missing dependencies with:
  sudo dnf install curl jq
EOF
      return 0
      ;;
    rhel | centos | rocky | almalinux)
      cat <<'EOF'
Install missing dependencies with:
  sudo dnf install curl jq
EOF
      return 0
      ;;
    arch | manjaro)
      cat <<'EOF'
Install missing dependencies with:
  sudo pacman -S curl jq
EOF
      return 0
      ;;
    opensuse* | suse)
      cat <<'EOF'
Install missing dependencies with:
  sudo zypper install curl jq
EOF
      return 0
      ;;
    esac
  fi

  cat <<'EOF'
Install missing dependencies with your OS package manager:
  curl jq
EOF
}

check_required_dependencies() {
  local missing=() dep
  for dep in curl jq; do
    command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
  done

  ((${#missing[@]} == 0)) && return 0

  if ((${#missing[@]} == 1)); then
    printf "aiusage: missing required dependency: %s\n\n" "${missing[0]}" >&2
  else
    printf "aiusage: missing required dependencies: %s\n\n" "${missing[*]}" >&2
  fi
  required_dependency_install_hint >&2
  return 1
}

version_is_newer() {
  local candidate="$1" current="$2" i
  local candidate_parts=() current_parts=()

  [[ "$candidate" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]] || return 1
  [[ "$current" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]] || return 1

  IFS=. read -r -a candidate_parts <<<"$candidate"
  IFS=. read -r -a current_parts <<<"$current"

  for i in 0 1 2; do
    if ((10#${candidate_parts[$i]} > 10#${current_parts[$i]})); then
      return 0
    fi
    if ((10#${candidate_parts[$i]} < 10#${current_parts[$i]})); then
      return 1
    fi
  done

  return 1
}

aiusage_script_path() {
  local path="${BASH_SOURCE[0]}" link dir

  case "$path" in
  /*) ;;
  *) path="$PWD/$path" ;;
  esac

  while [[ -L "$path" ]]; do
    link=$(readlink "$path") || return 1
    case "$link" in
    /*) path="$link" ;;
    *) path="$(dirname "$path")/$link" ;;
    esac
  done

  dir=$(cd -P "$(dirname "$path")" && pwd) || return 1
  printf '%s/%s' "$dir" "$(basename "$path")"
}

script_version() {
  sed -n 's/^VERSION="\([0-9][0-9.]*\)"$/\1/p' "$1" | head -n 1
}

update_aiusage() {
  local script_path script_dir metadata tag latest_version download_url tmp downloaded_version

  check_required_dependencies

  script_path=$(aiusage_script_path) || {
    printf "aiusage update: could not resolve the installed script path\n" >&2
    return 1
  }
  script_dir=$(dirname "$script_path")
  if [[ ! -w "$script_dir" ]]; then
    printf "aiusage update: cannot write to %s; reinstall aiusage with a writable install directory\n" "$script_dir" >&2
    return 1
  fi

  if ! metadata=$(curl -fsSL "$UPDATE_RELEASE_API_URL"); then
    printf "aiusage update: could not check the latest release\n" >&2
    return 1
  fi
  tag=$(printf '%s' "$metadata" | jq -r '.tag_name // empty' 2>/dev/null) || true
  latest_version="${tag#v}"
  if [[ ! "$latest_version" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
    printf "aiusage update: latest release has an invalid version: %s\n" "${tag:-unknown}" >&2
    return 1
  fi

  if [[ "$latest_version" == "$VERSION" ]]; then
    printf "aiusage update: already up to date (%s)\n" "$VERSION"
    return 0
  fi
  if ! version_is_newer "$latest_version" "$VERSION"; then
    printf "aiusage update: installed version %s is newer than latest release %s\n" "$VERSION" "$latest_version"
    return 0
  fi

  tmp=$(mktemp "$script_dir/.aiusage.update.XXXXXX") || {
    printf "aiusage update: could not create a temporary file in %s\n" "$script_dir" >&2
    return 1
  }
  download_url="$UPDATE_RAW_BASE_URL/$tag/aiusage"
  if ! curl -fsSL "$download_url" -o "$tmp"; then
    rm -f "$tmp"
    printf "aiusage update: could not download %s\n" "$tag" >&2
    return 1
  fi

  downloaded_version=$(script_version "$tmp")
  if [[ "$downloaded_version" != "$latest_version" ]] || ! bash -n "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    printf "aiusage update: downloaded release failed validation\n" >&2
    return 1
  fi

  if ! chmod 755 "$tmp" || ! mv -f "$tmp" "$script_path"; then
    rm -f "$tmp"
    printf "aiusage update: could not replace %s\n" "$script_path" >&2
    return 1
  fi

  printf "aiusage update: updated %s to %s\n" "$VERSION" "$latest_version"
}

draw_bar() {
  local label="$1" percent="$2" note="${3:-}"
  percent=$(numeric_or "$percent" 0)
  percent="${percent%.*}"
  [[ -z "$percent" ]] && percent=0
  ((percent < 0)) && percent=0
  ((percent > 100)) && percent=100

  local filled=$((percent * BAR_WIDTH / 100))
  local empty=$((BAR_WIDTH - filled))

  # pick color
  local color="$GREEN"
  ((percent >= 60)) && color="$YELLOW"
  ((percent >= 85)) && color="$RED"

  local bar="${color}"
  for ((i = 0; i < filled; i++)); do bar+="$FILL"; done
  bar+="${DIM}"
  for ((i = 0; i < empty; i++)); do bar+="$EMPTY"; done
  bar+="${RESET}"

  if [[ -n "$note" ]]; then
    printf "  %-*s %b %3d%% ${DIM}· %s${RESET}\n" "$LABEL_WIDTH" "$label" "$bar" "$percent" "$note"
  else
    printf "  %-*s %b %3d%%\n" "$LABEL_WIDTH" "$label" "$bar" "$percent"
  fi
}

draw_unavailable() {
  local label="$1" note="${2:-}"
  local bar="${DIM}"
  for ((i = 0; i < BAR_WIDTH; i++)); do bar+="$EMPTY"; done
  bar+="${RESET}"
  if [[ -n "$note" ]]; then
    printf "  %-*s %b  --%% ${DIM}· %s${RESET}\n" "$LABEL_WIDTH" "$label" "$bar" "$note"
  else
    printf "  %-*s %b  --%%\n" "$LABEL_WIDTH" "$label" "$bar"
  fi
}

draw_error() {
  local msg="$1"
  printf "  ${RED}error:${RESET} %s\n" "$msg"
}

draw_credits_line() {
  local used="$1" limit="$2"
  local used_fmt limit_fmt
  used=$(numeric_or "$used" 0)
  limit=$(numeric_or "$limit" 0)
  used_fmt=$(awk "BEGIN{printf \"%.2f\", $used/100}" 2>/dev/null || echo "$used")
  limit_fmt=$(awk "BEGIN{printf \"%.2f\", $limit/100}" 2>/dev/null || echo "$limit")
  printf "  %-*s ${DIM}\$%s / \$%s${RESET}\n" "$LABEL_WIDTH" "" "$used_fmt" "$limit_fmt"
}

draw_credit_balance_line() {
  local label="$1" balance="$2"
  printf "  %-*s ${DIM}%s credits available${RESET}\n" "$LABEL_WIDTH" "$label" "$balance"
}

calculate_percent() {
  local used limit fallback
  used=$(numeric_or "${1:-0}" 0)
  limit=$(numeric_or "${2:-0}" 0)
  fallback=$(numeric_or "${3:-0}" 0)
  awk "BEGIN{l=$limit; if (l > 0) printf \"%.0f\", ($used / l) * 100; else print $fallback}" 2>/dev/null || echo "$fallback"
}

calculate_used_percent_from_remaining() {
  local remaining="${1:-}" fallback="${2:-0}"
  [[ -n "$remaining" && "$remaining" != "null" ]] || {
    echo "$fallback"
    return 0
  }
  remaining=$(numeric_or "$remaining" "")
  [[ -n "$remaining" ]] || {
    echo "$fallback"
    return 0
  }
  awk "BEGIN{printf \"%.0f\", 100 - $remaining}" 2>/dev/null || echo "$fallback"
}

macos_keychain_read() {
  local service="$1" account="${2:-}"
  command -v security >/dev/null 2>&1 || return 1
  if [[ -n "$account" ]]; then
    security find-generic-password -s "$service" -a "$account" -w 2>/dev/null
  else
    # Account-less lookup: items written by other tools may have no account.
    security find-generic-password -s "$service" -w 2>/dev/null
  fi
}

macos_keychain_write() {
  local service="$1" value="$2"
  command -v security >/dev/null 2>&1 || return 1
  # Keep the default keychain access controls so future reads still require
  # the user's normal approval policy. -U updates the existing item in place.
  security add-generic-password -s "$service" -a "$USER" -w "$value" -U 2>/dev/null
}

macos_keychain_clear() {
  local service="$1"
  command -v security >/dev/null 2>&1 || return 1
  security delete-generic-password -s "$service" -a "$USER" >/dev/null 2>&1
}

linux_ttl_cache_read() {
  local path="$1" ttl="$2"
  [[ -f "$path" ]] || return 1

  local now mtime age
  now=$(date +%s)
  mtime=$(stat -c %Y "$path" 2>/dev/null) || return 1
  age=$(( now - mtime ))
  (( age < ttl )) || {
    rm -f "$path"
    return 1
  }

  cat "$path"
}

linux_secure_cache_write() {
  local path="$1" value="$2" dir tmp
  dir=$(dirname "$path")
  mkdir -p "$dir"
  chmod 700 "$dir" 2>/dev/null || true
  # Write to a 0600 temp file created by mktemp and rename into place: no
  # window where the secret sits at the final path with default permissions,
  # and an existing symlink is replaced instead of written through.
  tmp=$(mktemp "$dir/.aiusage.XXXXXX") || return 1
  if ! printf '%s' "$value" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$path"
}

HTTP_STATUS="000"
HTTP_BODY=""
http_json() {
  local url="$1" body="$2"
  shift 2

  # Headers and body are passed as curl arguments instead of temp files:
  # they carry bearer tokens and session cookies, which must not touch
  # disk where a signal or crash mid-request would leave them behind.
  # Trade-off: the header values are briefly visible in the process list.
  local tmp_body status curl_args=(-s --max-time 10 -w "%{http_code}") h
  for h in "$@"; do
    curl_args+=(-H "$h")
  done
  [[ -n "$body" ]] && curl_args+=(--data-binary "$body")

  tmp_body=$(mktemp)
  if ! status=$(curl "${curl_args[@]}" -o "$tmp_body" "$url" 2>/dev/null); then
    status="000"
  fi
  [[ "$status" =~ ^[0-9]{3}$ ]] || status="000"
  HTTP_STATUS="$status"
  HTTP_BODY=$(<"$tmp_body")
  rm -f "$tmp_body"
}

draw_http_error() {
  local status="$1" expired_msg="$2"
  case "$status" in
  401 | 403) draw_error "$expired_msg" ;;
  000) draw_error "network error or request timed out" ;;
  *) draw_error "request failed (HTTP $status)" ;;
  esac
}

