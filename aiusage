# Portable mtime in seconds. GNU stat must be tried first: BSD stat -f
# takes a format string, but GNU stat -f means --file-system, so the old
# BSD-first ordering produced garbage output on Linux.
file_mtime() {
  local mtime
  mtime=$(stat -c "%Y" "$1" 2>/dev/null || stat -f "%m" "$1" 2>/dev/null) || true
  case "$mtime" in
  '' | *[!0-9]*) printf "0" ;;
  *) printf "%s" "$mtime" ;;
  esac
}

find_jetbrains_quota_file() {
  local roots=()
  [[ -d "$HOME/Library/Application Support/JetBrains" ]] && roots+=("$HOME/Library/Application Support/JetBrains")
  [[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/JetBrains" ]] && roots+=("${XDG_CONFIG_HOME:-$HOME/.config}/JetBrains")
  (( ${#roots[@]} == 0 )) && return 0

  local file newest_file="" newest_mtime=0 mtime
  while IFS= read -r file; do
    mtime=$(file_mtime "$file")
    if ((mtime > newest_mtime)); then
      newest_mtime="$mtime"
      newest_file="$file"
    fi
  done < <(find "${roots[@]}" -path "*/options/AIAssistantQuotaManager2.xml" -type f 2>/dev/null)

  printf "%s" "$newest_file"
}

xml_unescape() {
  local value="${1:-}"
  value="${value//&quot;/\"}"
  value="${value//&#10;/$'\n'}"
  value="${value//&#13;/$'\r'}"
  value="${value//&apos;/\'}"
  value="${value//&lt;/<}"
  value="${value//&gt;/>}"
  value="${value//&amp;/&}"
  printf "%s" "$value"
}

duration_to_label() {
  local duration="${1:-}"
  if [[ "$duration" =~ ^PT([0-9]+)H$ ]]; then
    # Force base 10: leading-zero hours would be read as octal.
    local hours=$((10#${BASH_REMATCH[1]}))
    if ((hours % 24 == 0)); then
      printf "%sd" "$((hours / 24))"
      return 0
    fi
    printf "%sh" "$hours"
    return 0
  fi

  if [[ "$duration" =~ ^P([0-9]+)D$ ]]; then
    # Text-only: no arithmetic, so huge values render unchanged.
    printf "%sd" "$(strip_leading_zeros "${BASH_REMATCH[1]}")"
    return 0
  fi

  printf "Credits"
}

jetbrains_quota_to_credits() {
  local quota
  quota=$(numeric_or "${1:-}" "")
  [[ -n "$quota" ]] || return 0

  awk "BEGIN {
    value = $quota / 100000
    formatted = sprintf(\"%.2f\", value)
    sub(/\\.?0+$/, \"\", formatted)
    printf \"%s\", formatted
  }" 2>/dev/null
}

codex_window_label() {
  local seconds="${1:-}" fallback="${2:-}"

  if [[ "$seconds" =~ ^[0-9]+$ ]]; then
    # Force base 10: leading-zero seconds would be read as octal.
    seconds=$((10#$seconds))
    if ((seconds > 0)); then
      if ((seconds == 604800)); then
        printf "Weekly"
      elif ((seconds % 86400 == 0)); then
        printf "%sd" "$((seconds / 86400))"
      elif ((seconds % 3600 == 0)); then
        printf "%sh" "$((seconds / 3600))"
      else
        printf "%sm" "$((seconds / 60))"
      fi
      return 0
    fi
  fi

  printf "%s" "$fallback"
}

codex_spark_window_label() {
  local label="$1"
  if [[ "$label" == "Weekly" ]]; then
    printf "Spark Wk"
  else
    printf "Spark %s" "$label"
  fi
}

codex_window_reset_mode() {
  local seconds="${1:-}" fallback="${2:-datetime}"
  if [[ "$seconds" =~ ^[0-9]+$ ]]; then
    # Force base 10: leading-zero seconds would be read as octal.
    ((10#$seconds < 86400)) && printf "time" || printf "datetime"
  else
    printf "%s" "$fallback"
  fi
}

codex_resolve_reset_epoch() {
  local absolute_epoch relative_seconds reference_epoch resolved
  absolute_epoch=$(normalize_epoch "${1:-}")
  if [[ -n "$absolute_epoch" ]]; then
    printf '%s' "$absolute_epoch"
    return 0
  fi

  relative_seconds=$(numeric_or "${2:-}" "")
  reference_epoch=$(numeric_or "${3:-}" "")
  [[ -n "$relative_seconds" && -n "$reference_epoch" ]] || return 0

  resolved=$(awk "BEGIN { printf \"%.0f\", $reference_epoch + $relative_seconds }" 2>/dev/null) || true
  printf '%s' "$resolved"
}

normalize_epoch() {
  local raw="${1:-}" parsed
  [[ -z "$raw" || "$raw" == "null" ]] && return 0

  if [[ "$raw" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    # Force base 10: leading-zero timestamps would be read as octal.
    local int=$((10#${raw%%.*}))
    # Convert milliseconds to seconds when timestamps are too large.
    ((int > 100000000000)) && int=$((int / 1000))
    echo "$int"
    return 0
  fi

  # Claude often returns ISO timestamps with fractional seconds and/or offsets.
  # Normalize those variants and parse with local `date`.
  local cleaned
  cleaned=$(printf "%s" "$raw" | sed -E 's/([0-9])\.[0-9]+/\1/')
  if [[ "$cleaned" == *Z ]]; then
    cleaned="${cleaned%Z}+0000"
  fi
  cleaned=$(printf "%s" "$cleaned" | sed -E 's/([+-][0-9]{2}):([0-9]{2})$/\1\2/')

  if parsed=$(date -j -f "%Y-%m-%dT%H:%M:%S%z" "$cleaned" "+%s" 2>/dev/null); then
    printf '%s\n' "$parsed"
    return 0
  fi

  if parsed=$(date -j -f "%Y-%m-%dT%H:%M:%S" "$cleaned" "+%s" 2>/dev/null); then
    printf '%s\n' "$parsed"
    return 0
  fi

  # Linux/GNU fallback.
  date -d "$raw" "+%s" 2>/dev/null || true
}

format_epoch_local() {
  local epoch="${1:-}" mode="${2:-datetime}"
  [[ -z "$epoch" ]] && return 0

  local format="+%b %d %I:%M%p" value=""
  [[ "$mode" == "time" ]] && format="+%I:%M%p"

  if ! value=$(date -r "$epoch" "$format" 2>/dev/null); then
    value=$(date -d "@$epoch" "$format" 2>/dev/null || true)
  fi

  if [[ "$mode" == "time" ]]; then
    value=$(printf "%s" "$value" | sed -E 's/^0//; s/AM$/am/; s/PM$/pm/')
  fi

  printf "%s" "$value"
}

format_remaining() {
  local seconds="${1:-}"
  [[ -z "$seconds" ]] && echo "unknown" && return 0

  if ((seconds <= 0)); then
    echo "now"
    return 0
  fi

  local days=$((seconds / 86400))
  local hours=$(((seconds % 86400) / 3600))
  local minutes=$(((seconds % 3600) / 60))

  if ((days > 0)); then
    printf "%dd %dh" "$days" "$hours"
  elif ((hours > 0)); then
    printf "%dh %dm" "$hours" "$minutes"
  else
    printf "%dm" "$minutes"
  fi
}

draw_reset() {
  local epoch="${1:-}" mode="${2:-datetime}" detail_label_width="${3:-6}"
  local reset_text="--"

  if [[ -n "$epoch" ]]; then
    local formatted now rel
    formatted=$(format_epoch_local "$epoch" "$mode")
    if [[ -n "$formatted" ]]; then
      now=$(date +%s)
      rel=$(format_remaining $((epoch - now)))
      reset_text="$formatted ($rel)"
    fi
  fi

  printf "  %-*s ${DIM}%-*s %s${RESET}\n" "$LABEL_WIDTH" "" "$detail_label_width" "reset:" "$reset_text"
}

draw_banked_resets() {
  local count="${1:-}" detail_label_width="${2:-7}"
  shift 2
  [[ "$count" =~ ^[0-9]+$ ]] || return 0
  count=$(strip_leading_zeros "$count")

  if (($# > 0)); then
    local expiry_epoch formatted now rel index=1 label
    now=$(date +%s)
    for expiry_epoch in "$@"; do
      formatted=$(format_epoch_local "$expiry_epoch")
      [[ -n "$formatted" ]] || continue
      rel=$(format_remaining $((expiry_epoch - now)))
      label="banked($index):"
      printf "  %-*s ${DIM}%-*s %s (%s)${RESET}\n" \
        "$LABEL_WIDTH" "" "$detail_label_width" "$label" "$formatted" "$rel"
      index=$((index + 1))
    done
    return 0
  fi

  local banked_text="$count resets"
  if [[ "$count" == "1" ]]; then
    banked_text="1 reset"
  fi

  printf "  %-*s ${DIM}banked: %s${RESET}\n" "$LABEL_WIDTH" "" "$banked_text"
}

codex_detail_label_width() {
  local banked_count="${1:-0}" label="reset:"
  if [[ "$banked_count" =~ ^[0-9]+$ ]] && ((10#$banked_count > 0)); then
    label="banked($banked_count):"
  fi

  printf '%s' "${#label}"
}

SPINNER_FRAMES=('|' '/' '-' '\')
CURSOR_HIDDEN=0

hide_cursor() {
  if [[ -t 1 && $CURSOR_HIDDEN -eq 0 ]]; then
    printf "\033[?25l"
    CURSOR_HIDDEN=1
  fi
}

show_cursor() {
  if [[ -t 1 && $CURSOR_HIDDEN -eq 1 ]]; then
    printf "\033[?25h"
    CURSOR_HIDDEN=0
  fi
}

render_line() {
  printf "\033[2K%s\n" "$1"
}

render_heading_line() {
  printf "\033[2K%b%s%b\n" "$BOLD" "$1" "$RESET"
}

render_compact_status_line() {
  local frame="$1" done_count="$2" total_count="$3"
  local spin="${SPINNER_FRAMES[$((frame % ${#SPINNER_FRAMES[@]}))]}"
  printf "\r\033[2K%b%s%b %d/%d providers complete" "$DIM" "$spin" "$RESET" "$done_count" "$total_count"
}

WAIT_LABELS=()
WAIT_PIDS=()
WAIT_TMPS=()

wait_and_render_fetches() {
  local frame=0 i all_done pid_index line
  local done_count=0
  local wait_done=()
  local wait_status=()

  for ((i = 0; i < ${#WAIT_PIDS[@]}; i++)); do
    wait_done+=(0)
    wait_status+=(0)
  done

  hide_cursor
  if [[ -t 1 ]]; then
    while true; do
      all_done=1
      done_count=0
      for ((i = 0; i < ${#WAIT_PIDS[@]}; i++)); do
        if ((wait_done[i] == 0)); then
          kill -0 "${WAIT_PIDS[$i]}" 2>/dev/null || wait_done[$i]=1
        fi
        if ((wait_done[i])); then
          # Plain assignment: ((done_count++)) returns 1 when incrementing from
          # zero, which aborts strict-mode runs on bash >= 4.
          done_count=$((done_count + 1))
        else
          all_done=0
        fi
      done

      render_compact_status_line "$frame" "$done_count" "${#WAIT_LABELS[@]}"
      if ((all_done)); then
        break
      fi

      sleep 0.08
      frame=$((frame + 1))
    done
  fi

  for pid_index in ${WAIT_PIDS[@]+"${!WAIT_PIDS[@]}"}; do
    if wait "${WAIT_PIDS[$pid_index]}"; then
      wait_status[$pid_index]=0
    else
      wait_status[$pid_index]=$?
    fi
  done
  # Workers are reaped; drop the PIDs so later cleanup cannot SIGTERM a
  # recycled PID belonging to an unrelated process.
  WAIT_PIDS=()

  if [[ -t 1 ]]; then
    printf "\r\033[2K"
  fi

  for ((i = 0; i < ${#WAIT_LABELS[@]}; i++)); do
    if ((i > 0)); then
      render_line ""
    fi
    render_heading_line "${WAIT_LABELS[$i]}"
    while IFS= read -r line || [[ -n "$line" ]]; do
      render_line "$line"
    done <"${WAIT_TMPS[$i]}"
    # A nonzero worker status means a crash or partial render, even if the
    # section already produced output; say so instead of looking successful.
    if ((wait_status[i] != 0)); then
      render_line "$(draw_error "provider check failed")"
    fi
  done

  show_cursor
}

cleanup_running_fetches() {
  local pid tmp
  show_cursor
  # ${arr[@]+...} guard: expanding an empty array errors under set -u on
  # bash < 4.4 (macOS ships bash 3.2).
  for pid in ${WAIT_PIDS[@]+"${WAIT_PIDS[@]}"}; do
    kill "$pid" 2>/dev/null || true
  done
  for tmp in ${WAIT_TMPS[@]+"${WAIT_TMPS[@]}"}; do
    rm -f "$tmp"
  done
}

start_provider_fetches() {
  local provider label fetch_fn tmp
  WAIT_LABELS=()
  WAIT_PIDS=()
  WAIT_TMPS=()

  for provider in "$@"; do
    label=$(provider_label "$provider")
    fetch_fn=$(provider_fetch_fn "$provider")
    tmp=$(mktemp)
    # Capture worker stderr into its section: stray errors would otherwise
    # overwrite the live spinner line on the terminal.
    "$fetch_fn" >"$tmp" 2>&1 &
    WAIT_LABELS+=("$label")
    WAIT_PIDS+=("$!")
    WAIT_TMPS+=("$tmp")
  done
}

run_fetches_with_loading() {
  start_provider_fetches "$@"

  # These handlers replace the entry-point EXIT trap, so they must also
  # print the trailing newline it promises.
  trap 'cleanup_running_fetches; printf "\n"; trap - INT;  kill -INT  $$' INT
  trap 'cleanup_running_fetches; printf "\n"; trap - TERM; kill -TERM $$' TERM
  trap 'cleanup_running_fetches; printf "\n"' EXIT

  wait_and_render_fetches
  cleanup_running_fetches
  WAIT_LABELS=()
  WAIT_PIDS=()
  WAIT_TMPS=()
  trap - EXIT INT TERM
}

run_named_providers() {
  local selected=() unavailable=() provider unavailable_msg

  for provider in "$@"; do
    if (( ${#selected[@]} > 0 )) && provider_list_contains "$provider" "${selected[@]}"; then
      continue
    fi
    if (( ${#unavailable[@]} > 0 )) && provider_list_contains "$provider" "${unavailable[@]}"; then
      continue
    fi

    if provider_available "$provider"; then
      selected+=("$provider")
    else
      unavailable+=("$provider")
    fi
  done

  if (( ${#selected[@]} > 0 )); then
    run_fetches_with_loading "${selected[@]}"
  fi

  if (( ${#unavailable[@]} > 0 )); then
    for provider in "${unavailable[@]}"; do
      unavailable_msg=$(provider_unavailable_message "$provider")
      printf "%s\n" "$unavailable_msg" >&2
    done
  fi

  # Report status through a global instead of the return value: callers must
  # not invoke this function inside `if !` or `||` contexts, which would
  # suppress errexit here and in every spawned worker.
  if (( ${#selected[@]} > 0 )); then
    NAMED_PROVIDERS_RC=0
  else
    NAMED_PROVIDERS_RC=1
  fi
}

run_all_parallel() {
  local available=() provider provider_list

  for provider in "${ALL_PROVIDERS[@]}"; do
    if provider_available "$provider"; then
      available+=("$provider")
    fi
  done

  if (( ${#available[@]} == 0 )); then
    provider_list=$(printf "%s, " "${ALL_PROVIDERS[@]}")
    provider_list="${provider_list%, }"
    printf "No AI providers found (%s).\n" "$provider_list" >&2
    return 1
  fi
  run_fetches_with_loading "${available[@]}"
}

# ── claude ──────────────────────────────────────────────

fetch_claude() {
  local creds_file="$HOME/.claude/.credentials.json"
  local token=""

  if [[ -f "$creds_file" ]]; then
    token=$(jq -r '.claudeAiOauth.accessToken // empty' "$creds_file" 2>/dev/null)
  fi

  if [[ -z "$token" ]]; then
    # try macOS keychain
    token=$(macos_keychain_read "Claude Code-credentials" | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null || true)
  fi

  if [[ -z "$token" ]]; then
    draw_error "not logged in run: claude /login"
    return
  fi

  local resp _status
  http_json \
    "https://api.anthropic.com/api/oauth/usage" "" \
    "Authorization: Bearer $token" \
    "anthropic-beta: oauth-2025-04-20" \
    "Accept: application/json"
  resp="$HTTP_BODY"
  _status="$HTTP_STATUS"

  if [[ "$_status" != 2* ]] || [[ -z "$resp" ]]; then
    draw_http_error "$_status" "session expired run: claude /login"
    return
  fi

  local five_hour seven_day five_hour_reset seven_day_reset fable fable_reset
  IFS=$'\037' read -r \
    five_hour seven_day five_hour_reset seven_day_reset fable fable_reset < <(
      printf '%s' "$resp" | jq -r '
        def object_or_empty: if type == "object" then . else {} end;
        def utilization(w): (w | object_or_empty).utilization;
        def first_reset(w):
          (w | object_or_empty) as $window
          | $window.reset_at // $window.resets_at // $window.resetAt // $window.resetsAt
            // $window.window_end // $window.window_end_at // $window.windowEnd // $window.windowEndAt;
        (.limits // [] | if type == "array" then map(objects) else [] end) as $limits
        | (first($limits[] | select(.kind == "session")) // {}) as $session
        | (first($limits[] | select(.kind == "weekly_all")) // {}) as $weekly
        | (first(
            $limits[]
            | select(.kind == "weekly_scoped")
            | select(try (
                (.scope.model.display_name // .scope.model.displayName // "")
                | tostring
                | test("fable"; "i")
              ) catch false)
          ) // {}) as $fable
        | [
            (utilization(.five_hour) // utilization(.fiveHour) // $session.percent // $session.utilization // ""),
            (utilization(.seven_day) // utilization(.sevenDay) // $weekly.percent // $weekly.utilization // ""),
            (first_reset(.five_hour) // first_reset(.fiveHour) // first_reset($session) // ""),
            (first_reset(.seven_day) // first_reset(.sevenDay) // first_reset($weekly) // ""),
            ($fable.percent // $fable.utilization // ""),
            (first_reset($fable) // "")
          ]
        | map(tostring)
        | join("\u001f")
      ' 2>/dev/null
    ) || true

  local five_hour_reset_epoch seven_day_reset_epoch
  five_hour_reset_epoch=$(normalize_epoch "$five_hour_reset")
  seven_day_reset_epoch=$(normalize_epoch "$seven_day_reset")

  if [[ -n "$five_hour" ]]; then
    draw_bar "5h" "${five_hour%.*}"
  else
    draw_unavailable "5h"
  fi
  draw_reset "$five_hour_reset_epoch" "time"

  if [[ -n "$seven_day" ]]; then
    draw_bar "Weekly" "${seven_day%.*}"
  else
    draw_unavailable "Weekly"
  fi
  draw_reset "$seven_day_reset_epoch"

  if [[ -n "$fable" ]]; then
    draw_bar "Fable" "$fable"
    draw_reset "$(normalize_epoch "$fable_reset")"
  fi

  local extra_enabled extra_util extra_used extra_limit
  IFS=$'\t' read -r extra_enabled extra_util extra_used extra_limit < <(
    printf '%s' "$resp" | jq -r '[(.extra_usage.is_enabled // false | tostring),
       (.extra_usage.utilization // ""),
       (.extra_usage.used_credits // ""),
       (.extra_usage.monthly_limit // "")] | @tsv' 2>/dev/null
  )

  if [[ "$extra_enabled" == "true" && -n "$extra_limit" && "$extra_limit" != "0" && "$extra_limit" != "null" ]]; then
    printf "\n"
    if [[ -n "$extra_util" ]]; then
      draw_bar "Extra" "${extra_util%.*}"
    else
      draw_unavailable "Extra"
    fi
    draw_credits_line "${extra_used:-0}" "$extra_limit"
  fi
}

# ── codex ───────────────────────────────────────────────

fetch_codex() {
  local view="${1:-primary}"
  local creds_file="${CODEX_HOME:-$HOME/.codex}/auth.json"
  local token="" account_id=""

  if [[ -f "$creds_file" ]]; then
    token=$(jq -r '.tokens.access_token // empty' "$creds_file" 2>/dev/null)
    account_id=$(jq -r '.tokens.account_id // empty' "$creds_file" 2>/dev/null)
  fi

  if [[ -z "$token" ]]; then
    draw_error "not logged in run: codex login"
    return
  fi

  local headers=("Authorization: Bearer $token" "Accept: application/json")
  [[ -n "$account_id" ]] && headers+=("ChatGPT-Account-Id: $account_id")

  local resp _status
  http_json "https://chatgpt.com/backend-api/wham/usage" "" "${headers[@]}"
  resp="$HTTP_BODY"
  _status="$HTTP_STATUS"

  if [[ "$_status" != 2* ]] || [[ -z "$resp" ]]; then
    draw_http_error "$_status" "session expired log in to Codex again"
    return
  fi

  local primary primary_seconds primary_reset primary_reset_after
  local secondary secondary_seconds secondary_reset secondary_reset_after banked_resets
  IFS=$'\037' read -r \
    primary primary_seconds primary_reset primary_reset_after \
    secondary secondary_seconds secondary_reset secondary_reset_after banked_resets < <(
    printf '%s' "$resp" | jq -r 'def first_reset(w): w.reset_at // w.resets_at // w.resetAt // w.resetsAt // w.window_end // w.window_end_at // w.windowEnd // w.windowEndAt;
      [(.rate_limit.primary_window.used_percent // ""),
       (.rate_limit.primary_window.limit_window_seconds // ""),
       (first_reset(.rate_limit.primary_window) // ""),
       (.rate_limit.primary_window.reset_after_seconds // .rate_limit.primary_window.resetAfterSeconds // ""),
       (.rate_limit.secondary_window.used_percent // ""),
       (.rate_limit.secondary_window.limit_window_seconds // ""),
       (first_reset(.rate_limit.secondary_window) // ""),
       (.rate_limit.secondary_window.reset_after_seconds // .rate_limit.secondary_window.resetAfterSeconds // ""),
       (.rate_limit_reset_credits.available_count // "")] | map(tostring) | join("\u001f")' 2>/dev/null
  )

  local primary_reset_epoch secondary_reset_epoch reset_reference_epoch
  reset_reference_epoch=$(date +%s)
  primary_reset_epoch=$(codex_resolve_reset_epoch "$primary_reset" "$primary_reset_after" "$reset_reference_epoch")
  secondary_reset_epoch=$(codex_resolve_reset_epoch "$secondary_reset" "$secondary_reset_after" "$reset_reference_epoch")

  # The usage response only exposes the inventory count. Fetch individual
  # credits to find every expiry, but keep the count useful if this
  # undocumented endpoint is unavailable or changes shape.
  local banked_expiry_epochs=()
  if [[ "$view" != "spark" && "$banked_resets" =~ ^[0-9]+$ ]] && ((10#$banked_resets > 0)); then
    local banked_resp banked_status raw_expiry expiry_epoch
    http_json "https://chatgpt.com/backend-api/wham/rate-limit-reset-credits" "" "${headers[@]}"
    banked_resp="$HTTP_BODY"
    banked_status="$HTTP_STATUS"

    if [[ "$banked_status" == 2* && -n "$banked_resp" ]]; then
      while IFS= read -r raw_expiry; do
        expiry_epoch=$(normalize_epoch "$raw_expiry")
        [[ "$expiry_epoch" =~ ^[0-9]+$ ]] || continue
        banked_expiry_epochs+=("$expiry_epoch")
      done < <(
        printf '%s' "$banked_resp" |
          jq -r '[.credits[]? | select(.status == "available") | .expires_at // empty] | sort | .[]' 2>/dev/null || true
      )
    fi
  fi

  local primary_label secondary_label detail_label_width
  primary_label=$(codex_window_label "$primary_seconds" "5h")
  secondary_label=$(codex_window_label "$secondary_seconds" "Weekly")
  detail_label_width=$(codex_detail_label_width "${#banked_expiry_epochs[@]}")

  if [[ "$view" != "spark" ]]; then
    if [[ -n "$primary" ]]; then
      draw_bar "$primary_label" "$primary"
      draw_reset "$primary_reset_epoch" "$(codex_window_reset_mode "$primary_seconds" "time")" "$detail_label_width"
    fi

    if [[ -n "$secondary" ]]; then
      draw_bar "$secondary_label" "$secondary"
      draw_reset "$secondary_reset_epoch" "$(codex_window_reset_mode "$secondary_seconds" "datetime")" "$detail_label_width"
    fi

    if [[ -z "$primary" && -z "$secondary" ]]; then
      draw_unavailable "Usage"
    fi

    if ((${#banked_expiry_epochs[@]} > 0)); then
      draw_banked_resets "$banked_resets" "$detail_label_width" "${banked_expiry_epochs[@]}"
    else
      draw_banked_resets "$banked_resets" "$detail_label_width"
    fi
  fi

  local spark_primary spark_primary_seconds spark_primary_reset spark_primary_reset_after
  local spark_secondary spark_secondary_seconds spark_secondary_reset spark_secondary_reset_after
  IFS=$'\037' read -r \
    spark_primary spark_primary_seconds spark_primary_reset spark_primary_reset_after \
    spark_secondary spark_secondary_seconds spark_secondary_reset spark_secondary_reset_after < <(
    printf '%s' "$resp" | jq -r 'def first_reset(w): w.reset_at // w.resets_at // w.resetAt // w.resetsAt // w.window_end // w.window_end_at // w.windowEnd // w.windowEndAt;
      ((.additional_rate_limits // [])
       | map(select(((.limit_name // "") + " " + (.metered_feature // "")) | test("spark"; "i")))
       | first) as $spark
      | [($spark.rate_limit.primary_window.used_percent // ""),
         ($spark.rate_limit.primary_window.limit_window_seconds // ""),
         (first_reset($spark.rate_limit.primary_window) // ""),
         ($spark.rate_limit.primary_window.reset_after_seconds // $spark.rate_limit.primary_window.resetAfterSeconds // ""),
         ($spark.rate_limit.secondary_window.used_percent // ""),
         ($spark.rate_limit.secondary_window.limit_window_seconds // ""),
         (first_reset($spark.rate_limit.secondary_window) // ""),
         ($spark.rate_limit.secondary_window.reset_after_seconds // $spark.rate_limit.secondary_window.resetAfterSeconds // "")] | map(tostring) | join("\u001f")' 2>/dev/null
  )

  if [[ "$view" != "primary" && ( -n "$spark_primary" || -n "$spark_secondary" ) ]]; then
    local spark_primary_reset_epoch spark_secondary_reset_epoch
    spark_primary_reset_epoch=$(codex_resolve_reset_epoch "$spark_primary_reset" "$spark_primary_reset_after" "$reset_reference_epoch")
    spark_secondary_reset_epoch=$(codex_resolve_reset_epoch "$spark_secondary_reset" "$spark_secondary_reset_after" "$reset_reference_epoch")

    [[ "$view" == "both" ]] && printf "\n"
    if [[ -n "$spark_primary" ]]; then
      local spark_primary_label
      spark_primary_label=$(codex_spark_window_label "$(codex_window_label "$spark_primary_seconds" "5h")")
      draw_bar "$spark_primary_label" "$spark_primary"
      if [[ -n "$spark_primary_reset_epoch" ]]; then
        draw_reset "$spark_primary_reset_epoch" "$(codex_window_reset_mode "$spark_primary_seconds" "time")"
      fi
    fi

    if [[ -n "$spark_secondary" ]]; then
      local spark_secondary_label
      spark_secondary_label=$(codex_spark_window_label "$(codex_window_label "$spark_secondary_seconds" "Weekly")")
      draw_bar "$spark_secondary_label" "$spark_secondary"
      if [[ -n "$spark_secondary_reset_epoch" ]]; then
        draw_reset "$spark_secondary_reset_epoch" "$(codex_window_reset_mode "$spark_secondary_seconds" "datetime")"
      fi
    fi
  fi

  if [[ "$view" != "primary" ]]; then
    if [[ -z "$spark_primary" && -z "$spark_secondary" ]]; then
      [[ "$view" == "both" ]] && printf "\n"
      draw_error "Spark usage data is unavailable"
    fi
    [[ "$view" == "spark" ]] && return 0
  fi

  local has_credits credit_balance credits_unlimited
  IFS=$'\t' read -r has_credits credit_balance credits_unlimited < <(
    printf '%s' "$resp" | jq -r '[((.credits.has_credits // false) | tostring),
      (.credits.balance // ""),
      ((.credits.unlimited // false) | tostring)] | @tsv' 2>/dev/null
  )

  if [[ "$credits_unlimited" == "true" ]]; then
    printf "\n"
    draw_credit_balance_line "Extra" "unlimited"
  elif [[ "$has_credits" == "true" && -n "$credit_balance" && "$credit_balance" != "null" ]]; then
    printf "\n"
    draw_credit_balance_line "Extra" "$credit_balance"
  fi
}

fetch_codex_spark() {
  fetch_codex "spark"
}

fetch_codex_all() {
  fetch_codex "both"
}

